# Скопируйте на сервер в .env рядом с docker-compose.prod.yml и заполните

# Домен, на который будет выдаваться HTTPS-сертификат (укажите A-запись на IP сервера)
APP_DOMAIN=chat.example.com

# База данных
POSTGRES_DB=shadowvibe
POSTGRES_USER=shadowvibe
POSTGRES_PASSWORD=<сгенерируйте длинный пароль>

# Администратор (задайте обязательно, чтобы пароль не попал в логи)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<сгенерируйте длинный пароль>
ADMIN_EMAIL=admin@example.com

# Push-уведомления (те же ключи, что в локальном application.properties)
VAPID_PUBLIC_KEY=<public key>
VAPID_PRIVATE_KEY=<private key>
VAPID_SUBJECT=mailto:admin@shadowvibe.local